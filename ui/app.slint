import { Button } from "std-widgets.slint";

export App := Window {
    private property <int> count;

    min-width: 200px;

    VerticalLayout {  
        padding: 8px;
        spacing: 4px;

        Text {
            text: "count: " + count;
        }

        Button {
            text: "increment";
            clicked => {  
                count += 1;
            }
        }
    }
}